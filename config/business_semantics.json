      "circuito_dashboard": ["Shoppings Estático", "Shoppings Digital"],
      "subcircuito": ["REMEROS"],
      "circuito_negocio": "REMEROS",
      "portfolio_tier": "CORE",
      "incluye_performance_core": true,
      "incluye_conteo_general": true,
      "visible_por_defecto": true,
      "cobertura_catalogo": "COMPLETO",
